{
  "targets": [
    {
      "enabled": true,
      "storageType": "webdav",
      "config": {
        "displayName": "example-webdav",
        "server": "https://example.com/webdav",
        "username": "your-username",
        "password": "your-password",
        "baseDir": "/your-test-dir"
      }
    },
    {
      "enabled": true,
      "storageType": "s3",
      "config": {
        "displayName": "example-s3",
        "endPoint": "s3.amazonaws.com",
        "accessKey": "your-access-key",
        "secretKey": "your-secret-key",
        "bucketName": "your-bucket",
        "baseDir": "/your-test-dir",
        "region": "ap-southeast-1",
        "pathStyle": false,
        "type": "s3"
      }
    },
    {
      "enabled": true,
      "storageType": "s3",
      "config": {
        "displayName": "example-aliyun-oss",
        "endPoint": "oss-cn-hangzhou.aliyuncs.com",
        "accessKey": "your-access-key",
        "secretKey": "your-secret-key",
        "bucketName": "your-bucket",
        "baseDir": "/your-test-dir",
        "region": "cn-hangzhou",
        "pathStyle": false,
        "type": "aliyunOss"
      }
    }
  ]
}
